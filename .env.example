# Postgres (Railway service: web-db-main)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Auth.js
AUTH_SECRET= # openssl rand -base64 33
AUTH_URL=http://localhost:3000

# Discord OAuth app (https://discord.com/developers/applications)
# Redirect URI: <AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Redis (Railway service: web-db-additionally) - wired up when caching/sessions need it
REDIS_URL=
